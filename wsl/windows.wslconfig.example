# dotfiles-Debian/wsl/windows.wslconfig.example
# =============================================================================
# THIS FILE GOES ON THE WINDOWS SIDE, NOT INSIDE THE DISTRO. Copy it to:
#     %UserProfile%\.wslconfig      (e.g. C:\Users\<you>\.wslconfig)
# then run  wsl.exe --shutdown  and reopen the distro.
#
# It is the counterpart to wsl/wsl.conf, which is the distro-side file. Settings
# here are GLOBAL to WSL2 and cannot be set from inside the distro — putting them
# in /etc/wsl.conf does nothing, silently, which is why both files ship together.
#
# WHY networkingMode MATTERS
# By default WSL2 sits behind a NAT, so anything LISTENING inside the distro is
# not reachable from other hosts on your LAN — they reach the Windows host, not
# the WSL VM. That bites any inbound service: a dev server you want to hit from a
# phone, sshd into the WSL box, or a file-transfer listener. `mirrored` makes the
# distro share the Windows host's interfaces, so listeners are directly reachable
# and the distro's IP matches the host's. Requires Windows 11 22H2 or newer.
#
# The offensive Role layer (dotfiles-Offense) cares about this more than most —
# a reverse shell or handler is exactly an inbound listener — but the mechanism is
# an OS-native WSL2 fact, which is why it lives here rather than in that repo.
# =============================================================================

[wsl2]
networkingMode=mirrored
dnsTunneling=true
firewall=true
autoProxy=true

# Optional resource caps — uncomment/tune to taste:
# memory=8GB
# processors=4

[experimental]
# Reclaim freed memory back to Windows over time.
autoMemoryReclaim=gradual
