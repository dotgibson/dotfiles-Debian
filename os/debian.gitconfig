# dotfiles-Debian/os/debian.gitconfig
# ──────────────────────────────────────────────────────────────────────────────
# OS-specific git config. Symlinked to ~/.config/git/os.gitconfig by bootstrap.sh
# and pulled in by Core's gitconfig. Holds ONLY what differs by OS/environment —
# on macOS this would be osxkeychain; here it's a Linux-appropriate helper.
#
# Do NOT set [init] defaultBranch or anything else Core already sets: this file is
# included AFTER Core's, so a duplicate key here silently shadows Core's value.
# ──────────────────────────────────────────────────────────────────────────────

[credential]
	# Safe universal default: cache credentials in memory for 24h. No extra
	# packages, and it works on a headless box where no keyring is unlocked.
	helper = cache --timeout=86400
	#
	# Better option once you know your environment — desktop Debian/Ubuntu with a
	# running keyring daemon (persistent, encrypted at rest):
	#       helper = /usr/libexec/git-core/git-credential-libsecret
	#       install:  sudo apt install libsecret-1-0 libsecret-1-dev
	#
	# NOTE the path differs from Fedora's (/usr/libexec/git-core/...) on older
	# releases, where Debian used /usr/lib/git-core/. Confirm with:
	#       dpkg -L git | grep credential-libsecret
	# On a headless SSH box this is the WRONG choice — libsecret needs an unlocked
	# keyring, so it prompts into a session that isn't there. Keep `cache`.
